# Neon pooled URL for the app runtime (Prisma adapter)
DATABASE_URL=

# Optional: Neon direct (non-pooler) URL for migrations if pooled URL fails
# DIRECT_URL=

FRONTEND_URL=http://localhost:4200
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=3000

# Platform superadmin (seed with: npm run db:seed)
SUPERADMIN_EMAIL=superadmin@flowdesk.local
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Shared password for demo org users (admin/manager/member/viewer@acme.dev)
DEMO_PASSWORD=

# Allow GET /auth/demo-personas and POST /auth/demo-login
DEMO_LOGIN_ENABLED=true

# Temporary bootstrap key for superadmin-only APIs before JWT login exists
SUPERADMIN_BOOTSTRAP_KEY=
