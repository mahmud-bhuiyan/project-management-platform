      "item": [
        {
          "name": "Get demo personas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Demo personas retrieved', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.personas).to.be.an('array');",
                  "  if (json.data.personas.length > 0) {",
                  "    pm.expect(json.data.personas[0].email).to.be.a('string');",
                  "    pm.expect(json.data.personas[0].password).to.be.undefined;",
                  "  }",
                  "});"
