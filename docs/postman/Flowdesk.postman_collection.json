                  "pm.test('Organization created', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.organization.name).to.be.a('string');",
                  "  pm.expect(json.data.organization.slug).to.be.a('string');",
